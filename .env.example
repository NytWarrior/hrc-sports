# MongoDB Atlas connection string or local MongoDB URI
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/hrc_sports?retryWrites=true&w=majority

# Generate a long random secret (at least 24 characters). Server-only; never prefix with NEXT_PUBLIC_
ADMIN_TOKEN=replace-with-a-long-random-secret-at-least-24-characters

# Initial defaults only; live rates can be changed in /admin after authentication.
MORNING_HOURLY_RATE=800
AFTERNOON_HOURLY_RATE=800
EVENING_HOURLY_RATE=1000
